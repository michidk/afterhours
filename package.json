{
  "name": "afterhours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "scripts/build-physics.sh && tsc --noEmit && vite build",
    "start": "cargo run --release -p afterhours-server",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "city:generate": "tsx scripts/generate-city.ts",
    "city:meshes": "tsx scripts/bake-city-meshes.ts",
    "city:prepare": "tsx scripts/prepare-city.ts",
    "map:explore": "vite --config vite.explorer.config.ts",
    "map:build": "vite build --config vite.explorer.config.ts",
    "map:stats": "tsx scripts/mapgen-stats.ts",
    "audio:prepare": "tsx scripts/prepare-audio.ts",
    "format": "prettier --write .",
    "check": "scripts/build-physics.sh && prettier --check . && tsx scripts/check-boundaries.ts && tsc --noEmit",
    "bench:physics": "tsx scripts/physics-benchmark.ts",
    "bench:simulation": "tsx scripts/simulation-timing.ts",
    "bench:server": "tsx scripts/server-profile.ts",
    "bench:ticks": "tsx scripts/tick-spikes.ts",
    "bench:lod": "tsx scripts/lod-ab.ts",
    "bench:load": "tsx scripts/load-test.ts",
    "test:deployment": "tsx scripts/deployment-test.ts",
    "debug": "tsx scripts/debug.ts",
    "test:traffic": "tsx scripts/traffic-scenario.ts",
    "probe:multiplayer": "tsx scripts/multiplayer-probe.ts",
    "test:five-clients": "tsx scripts/five-client-test.ts",
    "server": "cargo run -p afterhours-server"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@msgpack/msgpack": "^3.1.3",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
