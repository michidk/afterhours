{
  "name": "afterhours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "city:generate": "tsx scripts/generate-city.ts",
    "audio:prepare": "tsx scripts/prepare-audio.ts",
    "format": "prettier --write .",
    "check": "prettier --check . && tsx scripts/check-boundaries.ts && tsc --noEmit",
    "bench:physics": "tsx scripts/physics-benchmark.ts",
    "bench:load": "tsx scripts/load-test.ts",
    "test:deployment": "tsx scripts/deployment-test.ts",
    "debug": "tsx scripts/debug.ts",
    "test:traffic": "tsx scripts/traffic-scenario.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@msgpack/msgpack": "^3.1.3",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
